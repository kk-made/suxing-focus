{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/splash/index",
      "style": {
        "navigationStyle": "custom",
        "backgroundColor": "#FFFFFF",
        "disableScroll": true
      }
    },
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "今日",
        "navigationBarBackgroundColor": "#FFFFFF",
        "backgroundColor": "#FFFFFF"
      }
    },
    {
      "path": "pages/goal/list",
      "style": {
        "navigationBarTitleText": "目标",
        "navigationBarBackgroundColor": "#FFFFFF",
        "backgroundColor": "#FFFFFF"
      }
    },
    {
      "path": "pages/goal/detail",
      "style": {
        "navigationBarTitleText": "目标详情",
        "navigationBarBackgroundColor": "#FFFFFF",
        "backgroundColor": "#FFFFFF"
      }
    },
    {
      "path": "pages/goal/edit",
      "style": {
        "navigationBarTitleText": "新建目标",
        "navigationBarBackgroundColor": "#FFFFFF",
        "backgroundColor": "#FFFFFF"
      }
    },
    {
      "path": "pages/plan/schedule",
      "style": {
        "navigationBarTitleText": "调整排期",
        "navigationBarBackgroundColor": "#FFFFFF",
        "backgroundColor": "#FFFFFF"
      }
    },
    {
      "path": "pages/stats/index",
      "style": {
        "navigationBarTitleText": "统计",
        "navigationBarBackgroundColor": "#FFFFFF",
        "backgroundColor": "#FFFFFF"
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationBarBackgroundColor": "#FFFFFF",
        "backgroundColor": "#FFFFFF"
      }
    },
    {
      "path": "pages/mine/guide",
      "style": {
        "navigationBarTitleText": "使用指南",
        "navigationBarBackgroundColor": "#FFFFFF",
        "backgroundColor": "#FFFFFF"
      }
    },
    {
      "path": "pages/achieve/index",
      "style": {
        "navigationBarTitleText": "成就收藏集",
        "navigationBarBackgroundColor": "#FFFFFF",
        "backgroundColor": "#FFFFFF"
      }
    },
    {
      "path": "pages/focus/index",
      "style": {
        "navigationStyle": "custom",
        "backgroundColor": "#FFFFFF",
        "disableScroll": true
      }
    }
  ],
  "tabBar": {
    "color": "#8c8c86",
    "selectedColor": "#b87b5a",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "height": "100rpx",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "今日",
        "iconPath": "static/tab/day.png",
        "selectedIconPath": "static/tab/day-on.png"
      },
      {
        "pagePath": "pages/goal/list",
        "text": "目标",
        "iconPath": "static/tab/goal.png",
        "selectedIconPath": "static/tab/goal-on.png"
      },
      {
        "pagePath": "pages/stats/index",
        "text": "统计",
        "iconPath": "static/tab/stats.png",
        "selectedIconPath": "static/tab/stats-on.png"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的",
        "iconPath": "static/tab/me.png",
        "selectedIconPath": "static/tab/me-on.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "溯星",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#FFFFFF",
    "backgroundColorTop": "#FFFFFF",
    "backgroundColorBottom": "#FFFFFF"
  }
}
